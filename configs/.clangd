# robotics-style-guide v1.0.0
# PROS exposes almost everything through umbrella headers, so clangd's
# "included header is not used directly" warning is noise for them.
# If you already have a .clangd with existing directives copy and paste this into the existing file  
Diagnostics:
  UnusedIncludes: None

# Checks doc comments: wrong @param names, @return on void functions, and similar.
CompileFlags:
  Add: [-Wdocumentation]

# Formats Doxygen tags in hover. Needs a recent clangd; older versions ignore it
# and show the comment as plain text.
Documentation:
  CommentFormat: Doxygen
