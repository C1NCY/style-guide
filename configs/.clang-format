# robotics-style-guide v1.0.0
BasedOnStyle: Google
Standard: c++20
ColumnLimit: 100
BinPackArguments: false
BinPackParameters: false
IncludeBlocks: Regroup
IncludeCategories:
  - {Regex: '^<[^/]+\.h>$', Priority: 1}          # C system
  - {Regex: '^<[^/.]+>$', Priority: 2}            # C++ standard
  - {Regex: '^"(include/)?(fmt|lemlib|liblvgl|pros|units)/', Priority: 3} # libraries
  - {Regex: '.*', Priority: 4}                    # project